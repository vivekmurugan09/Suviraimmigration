    <style>
        :root {
            --primary: #147e52;
            --accent: #3abb85;
            --dark: #d8d1d1;
            --glass: rgba(238, 229, 229, 0.93);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--dark);
            color: #fff;
            font-family: 'Segoe UI', sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            /* Shaking effect on the whole screen for the "crash" */
            animation: cameraShake 0.8s cubic-bezier(.36,.07,.19,.97) both;
            animation-delay: 1.2s;
        }

        /* 3D Scene Layer */
        .world {
            position: relative;
            text-align: center;
            z-index: 5;
            perspective: 1000px;
        }

        /* The 3D Flight Crash Visual */
        .plane-box {
            position: relative;
            width: 300px;
            margin: 0 auto -50px;
            transform-style: preserve-3d;
            z-index: 10;
        }

        .plane-box img {
            width: 100%;
            /* Animation: Plane nosedives and then stays shaking */
            animation: nosedive 1.5s ease-out forwards, vibrate 0.2s infinite;
        }

        /* Ground Impact Shadow */
        .impact-glow {
            position: absolute;
            bottom: -20px;
            left: 50%;
            transform: translateX(-50%) rotateX(75deg);
            width: 250px;
            height: 100px;
            background: radial-gradient(circle, var(--primary) 0%, transparent 70%);
            filter: blur(20px);
            opacity: 0;
            animation: reveal 0.5s forwards;
            animation-delay: 1.2s;
        }

        /* Main Premium Card */
        .card {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            border: 1px solid rgba(58, 187, 133, 0.2);
            padding: 80px 40px 50px;
            border-radius: 40px;
            box-shadow: 0 50px 100px rgba(0,0,0,0.8), inset 0 0 20px rgba(20, 126, 82, 0.2);
            max-width: 500px;
            width: 90%;
        }

        .code {
            font-size: 9rem;
            font-weight: 900;
            line-height: 0.8;
            letter-spacing: -8px;
            background: linear-gradient(to bottom, #fff 30%, var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 20px;
            filter: drop-shadow(0 0 15px rgba(20, 126, 82, 0.3));
        }

        h1 { 
            font-size: 1.4rem; 
            text-transform: uppercase; 
            letter-spacing: 5px; 
            color: var(--accent);
            margin-bottom: 15px;
        }

        p { color: #888; line-height: 1.6; margin-bottom: 35px; }

        /* The "Back to Home" Button */
        .btn {
            display: inline-block;
            padding: 18px 50px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #fff;
            text-decoration: none;
            border-radius: 15px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 0.85rem;
            transition: 0.4s;
            box-shadow: 0 10px 30px rgba(20, 126, 82, 0.4);
        }

        .btn:hover {
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 20px 40px rgba(179, 194, 188, 0.6);
        }

        /* ANIMATIONS */
        @keyframes nosedive {
            0% { transform: translateY(-500px) rotate(-45deg) scale(1.5); opacity: 0; }
            80% { transform: translateY(0) rotate(-10deg) scale(1); opacity: 1; }
            100% { transform: translateY(5px) rotate(2deg) scale(1); opacity: 1; }
        }

        @keyframes cameraShake {
            10%, 90% { transform: translate3d(-1px, 0, 0); }
            20%, 80% { transform: translate3d(2px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
            40%, 60% { transform: translate3d(4px, 0, 0); }
        }

        @keyframes vibrate {
            0% { transform: translate(0); }
            25% { transform: translate(1px, 1px); }
            50% { transform: translate(-1px, -1px); }
            75% { transform: translate(1px, -1px); }
            100% { transform: translate(0); }
        }

        @keyframes reveal { from { opacity: 0; } to { opacity: 0.6; } }

    </style>
</head>
