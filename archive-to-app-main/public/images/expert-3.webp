  <style>

    /* === Base Navbar Styling === */

    .navbar-custom {

      background-color: #fff;

      border-radius: 0 0 15px 15px;

      padding: 10px 30px;

    }

    .navbar-brand img {

      height: 50px;

    }

    .navbar-nav .nav-link {

      color: #168366 !important;

      font-weight: 600;

      margin: 0 10px;

      position: relative;

      line-height: 1.6;

    }

    .navbar-nav .nav-link:hover {

      color: #0d5d4d !important;

    }

    .navbar-nav .nav-link:focus {

      outline: none;

      box-shadow: none;

    }

    /* === Dropdown Styling === */

    .dropdown-menu {

      background-color: #fff;

      border: 1px solid #d7d7d7;

      border-top: 3px solid #168366;

      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);

      border-radius: 0;

    }

    .dropdown-item {

      color: #000;

      font-weight: 500;

      font-size:18px;

      line-height: 2.8;

    }

    a {

  text-decoration: none;

}

    .dropdown-item:hover {

      background-color: #168366;

      color: #fff;

       text-decoration: none;

    }

    /* === Submenu Styling === */

    .dropdown-submenu {

      position: relative;

    }

    .dropdown-submenu .dropdown-menu {

      top: 0;

      left: 100%;

      margin-left: 0.5rem;

      margin-top: -1px;

      border-top: 3px solid #168366;

    }

    /* Reduce font size in laptop view (992px – 1600px) */

@media (min-width: 992px) and (max-width: 1400px) {

  .navbar-nav .nav-link {

    font-size: 13px !important;

    margin: 0 4px;  /* reduce spacing also */

  }

  .dropdown-item {

    font-size: 15px !important;

  }

  .eligibility-btn {

    font-size: 13px !important;

    padding: 8px 14px !important;

  }

}

    /* === Desktop Hover Dropdown === */

    @media (min-width: 992px) {

      .navbar .dropdown:hover>.dropdown-menu {

        display: block;

      }

      .dropdown-submenu:hover>.dropdown-menu {

        display: block;

      }

      .dropdown-toggle .fa-plus,

      .dropdown-toggle .fa-minus {

        display: none !important;

      }

    }

       @media (min-width: 992px) {

    .hide{

      display: none;

    }

    }

    /* === Mobile Accordion Styling === */

    @media (max-width: 991px) {

      .navbar-collapse {

        background-color: #fff;

        border-top: 1px solid #e0e0e0;

      }

      .dropdown-toggle::after {

        display: none;

      }

      .navbar-nav .nav-link > img[alt="dropdown"] {

        display: none !important;

      }

      .navbar-nav .nav-item {

        border-bottom: 1px solid #e0e0e0;

      }

      .dropdown-toggle {

        display: flex;

        justify-content: flex-start;

        align-items: center;

        gap: 12px;

        width: 100%;

        min-width: 0;

        /* padding: 12px 10px; */

      }

      .dropdown-toggle .fa-plus,

      .dropdown-toggle .fa-minus {

        font-size: 14px;

        color: #168366;

      }

      .dropdown-toggle .mobile-icon {

        flex: 0 0 20px;

        width: 20px;

        margin-left: auto;

        margin-right: 8px;

      }

      .dropdown-menu {

        border: none;

        box-shadow: none;

        padding: 0;

        overflow: hidden;

        max-height: 0;

        transition: max-height 0.4s ease; /* ✅ smooth animation */

      }

      .dropdown-menu.show {

        max-height: 5000px;

        transition: max-height 0.5s ease;

      }

      /* .eligibility-check-menu.show {

        max-height: calc(100vh - 180px);

        overflow-y: auto;

        overflow-x: hidden;

        -webkit-overflow-scrolling: touch;

      } */

        /* =====================================

   MOBILE ELIGIBILITY CHECK FULL HEIGHT FIX

===================================== */

@media (max-width: 991px) {

    /* Main mobile navbar */

    #navbarNav {

        max-height: calc(100vh - 70px);

        overflow-y: auto !important;

        overflow-x: hidden;

        -webkit-overflow-scrolling: touch;

    }

    /* Eligibility dropdown */

    .eligibility-check-menu {

        display: block !important;

        position: static !important;

        float: none !important;

        width: 100%;

        max-height: 0;

        overflow: hidden;

        transition: max-height 0.5s ease;

        border: none !important;

        box-shadow: none !important;

    }

    /* When Eligibility Check is opened */

    .eligibility-check-menu.show {

        max-height: none !important;

        height: auto !important;

        overflow: visible !important;

    }

    /* Eligibility menu items */

    .eligibility-check-menu .dropdown-item {

        white-space: normal !important;

        line-height: 1.5 !important;

        padding: 14px 25px !important;

        height: auto !important;

    }

}

      .dropdown-item {

        padding: 12px 25px;

        border-bottom: 1px solid #e0e0e0;

        background-color: #f8f9fa;

      }

      .dropdown-item:last-child {

        border-bottom: none;

      }

      .dropdown-submenu>.dropdown-toggle {

        font-weight: 600;

      }

      .dropdown-submenu .dropdown-menu {

        background: #fff;

        padding-left: 15px;

      }

      /* Align text and spacing cleanly */

      .navbar-nav .nav-item a {

        font-size: 15px;

      }

    }

    .navbar-nav .nav-link:not(.eligibility-btn) {

  color: #168366 !important;

}

/* Force white text with high specificity  test   */

.navbar .navbar-nav .nav-link.eligibility-btn,

.navbar .navbar-nav .nav-link.eligibility-btn:focus,

.navbar .navbar-nav .nav-link.eligibility-btn:active,

.navbar .navbar-nav .show > .nav-link.eligibility-btn {

  background-color: #168366 !important;

  color: #ffffff !important;

  font-weight: bold !important;

  border-radius: 12px !important;

  padding: 10px 20px !important;

  white-space: nowrap !important;

}

/* Hover */

.navbar .navbar-nav .nav-link.eligibility-btn:hover {

  background-color: #0d5d4d !important;

  color: #ffffff !important;

}

/* Dropdown arrow white */

.navbar .navbar-nav .nav-link.eligibility-btn::after {

  border-top-color: #ffffff !important;

}

    /* === Eligibility Button === */

    .eligibility-btn {

      background-color: #168366;

      color: #fff !important;

      font-weight: bold;

      border-radius: 12px;

      padding: 10px 20px;

      white-space: nowrap;

    }

    .eligibility-btn:hover {

      background-color: #0d5d4d;

    }

/* Eligibility Check – mobile dropdown */

@media (max-width: 991px) {

   .eligibility-mobile-btn {

    width: 100%;

    background: #fff;

    border: none;

    padding: 15px;

    font-size: 16px;

    font-weight: 600;

    color: #168366;

    display: flex;

    justify-content: space-between;

    border-bottom: 1px solid #e0e0e0;

  } 

  .eligibility-mobile-btn .icon {

    font-size: 20px;

    font-weight: bold;

    color: #168366;

  }

  .eligibility-mobile-btn.dropdown-toggle {

    display: flex;

    align-items: center;

    justify-content: flex-start;

    gap: 12px;

    min-width: 0;

  }

  .eligibility-mobile-btn.dropdown-toggle .mobile-icon {

    flex: 0 0 20px;

    width: 20px;

    margin-left: auto;

  }

  .eligibility-submenu {

    max-height: 0;

    overflow: hidden;

    transition: max-height .4s ease;

    background: #f1f1f1;

    padding: 0;

    border: none;

  }

  .eligibility-submenu.show {

    max-height: 500px;

  }

  .eligibility-submenu .dropdown-item {

    padding: 12px 25px;

    font-size: 15px;

    border-bottom: 1px solid #ddd;

    background: #f8f9fa;

  }

}

.eligibility-btn {

  background-color: #168366 !important;

  color: #fff !important;

  font-weight: 600;

  border-radius: 12px;

  padding: 10px 20px;

}

/* Keep white on hover */

.eligibility-btn:hover {

  background-color: #0d5d4d !important;

  color: #fff !important;

}

/* Also force dropdown arrow white */

.eligibility-btn::after {

  border-top-color: #fff !important;

}

  /* Laptop / desktop header alignment only. */

@media (min-width: 992px) {

  .navbar-custom > .container-fluid {

    flex-wrap: nowrap;

  }

  .navbar-custom .navbar-brand {

    flex-shrink: 0;

  }

  .navbar-custom #navbarNav {

    min-width: 0;

  }

  .navbar-custom #navbarNav > .navbar-nav {

    flex-wrap: nowrap;

    align-items: center;

  }

  .navbar-custom #navbarNav > .navbar-nav > .nav-item {

    flex-shrink: 0;

  }

  .navbar-custom #navbarNav > .navbar-nav > .nav-item > a {

    white-space: nowrap;

  }

  /* Keep the rightmost calculator dropdown inside the viewport. */

  .navbar-custom #navbarNav > .navbar-nav > .nav-item:last-child > .dropdown-menu {

    left: auto;

    right: 0;

  }

}

@media (min-width: 992px) and (max-width: 1799.98px) {

  .navbar-custom {

    padding-left: clamp(10px, 1.5vw, 24px);

    padding-right: clamp(10px, 1.5vw, 24px);

  }

  .navbar-custom .navbar-brand {

    margin-right: clamp(8px, 1vw, 16px);

  }

  .navbar-custom .navbar-brand img {

    width: auto;

    height: auto;

    max-width: clamp(110px, 11vw, 176px);

    max-height: 50px;

  }

  .navbar-custom #navbarNav > .navbar-nav > .nav-item > .nav-link {

    font-size: clamp(12px, 0.95vw, 15px) !important;

    margin-left: clamp(1px, 0.25vw, 4px);

    margin-right: clamp(1px, 0.25vw, 4px);

    padding-left: clamp(3px, 0.4vw, 6px);

    padding-right: clamp(3px, 0.4vw, 6px);

  }

  /* Includes Pay Now, which does not have the nav-link class. */

  .navbar-custom #navbarNav > .navbar-nav > .nav-item > .eligibility-btn {

    font-size: clamp(12px, 0.95vw, 15px) !important;

    padding: 10px clamp(8px, 0.85vw, 14px) !important;

    white-space: nowrap !important;

  }

}

/* Keep logo, navigation and action buttons on the same vertical center. */

@media (min-width: 992px) {

  .navbar.navbar-custom > .container-fluid {

    display: flex;

    align-items: center !important;

  }

  .navbar.navbar-custom .navbar-brand {

    display: flex;

    align-items: center;

    align-self: center;

    margin-top: 0 !important;

    margin-bottom: 0 !important;

    padding-top: 0;

    padding-bottom: 0;

  }

  .navbar.navbar-custom .navbar-brand img {

    display: block;

  }

  .navbar.navbar-custom #navbarNav {

    align-items: center !important;

    align-self: center;

    margin-top: 0 !important;

    margin-bottom: 0 !important;

    padding-top: 0 !important;

    padding-bottom: 0 !important;

  }

  .navbar.navbar-custom #navbarNav > .navbar-nav {

    display: flex;

    align-items: center !important;

    margin-top: 0 !important;

    margin-bottom: 0 !important;

    padding-top: 0 !important;

    padding-bottom: 0 !important;

  }

  .navbar.navbar-custom #navbarNav > .navbar-nav > .nav-item {

    display: flex;

    align-items: center;

    margin-top: 0 !important;

    margin-bottom: 0 !important;

    padding-top: 0 !important;

    padding-bottom: 0 !important;

  }

  .navbar.navbar-custom #navbarNav > .navbar-nav > .nav-item > .nav-link:not(.d-lg-none),

  .navbar.navbar-custom #navbarNav > .navbar-nav > .nav-item > .eligibility-btn {

    display: flex !important;

    align-items: center;

    justify-content: center;

    margin-top: 0 !important;

    margin-bottom: 0 !important;

    line-height: 1.6;

  }

}

/* Compact spacing for small laptop viewports; keep labels on one line. */

@media (min-width: 992px) and (max-width: 1199.98px) {

  .navbar.navbar-custom { padding-left: 8px; padding-right: 8px; }

  .navbar.navbar-custom > .container-fluid { padding-left: 8px; padding-right: 8px; }

  .navbar.navbar-custom .navbar-brand { margin-right: 6px; }

  .navbar.navbar-custom .navbar-brand img { max-width: 100px; }

  .navbar.navbar-custom #navbarNav > .navbar-nav > .nav-item > .nav-link {

    font-size: 11.5px !important;

    margin-left: 0;

    margin-right: 0;

    padding-left: 1px;

    padding-right: 1px;

  }

  .navbar.navbar-custom #navbarNav > .navbar-nav > .nav-item > .eligibility-btn {

    font-size: 11.5px !important;

    padding-left: 6px !important;

    padding-right: 6px !important;

  }

}


/* Desktop dropdown positioning: anchor below the link, not its flex center. */
@media (min-width: 992px) {
  .navbar.navbar-custom #navbarNav > .navbar-nav > .nav-item.dropdown {
    position: relative;
  }

  .navbar.navbar-custom #navbarNav > .navbar-nav > .nav-item.dropdown > .dropdown-menu {
    position: absolute;
    top: 100%;
    bottom: auto;
    left: 0;
    right: auto;
    transform: none;
    margin-top: 0;
    margin-bottom: 0;
  }

  .navbar.navbar-custom #navbarNav > .navbar-nav > .nav-item:last-child > .dropdown-menu {
    left: auto;
    right: 0;
  }

  /* A continuous hover area between each parent row and its submenu. */
  .navbar.navbar-custom #navbarNav .dropdown-submenu > .dropdown-menu {
    position: absolute;
    top: 0;
    bottom: auto;
    left: 100%;
    right: auto;
    transform: none;
    margin: 0;
  }
}

